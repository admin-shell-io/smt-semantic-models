@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix : <urn:samm:io.admin-shell.idta.batterypass.digital_nameplate:1.0.0#> .
@prefix tech: <urn:samm:io.admin-shell.idta.batterypass.technical_data:1.0.0#> .

# Economic Operator profile:
# AddressInformation, DateOfPuttingIntoService, OperatorIdentifier and
# ManufacturerIdentifier are mandatory.
:BatteryNameplateEconomicOperatorShape
    a sh:NodeShape ;
    sh:targetSubjectsOf :uriOfTheProduct ;
    sh:node :BatteryNameplateBaseShape ;
    sh:property [ sh:path :addressInformation ; sh:minCount 1 ] ;
    sh:property [ sh:path :dateOfPuttingIntoService ; sh:minCount 1 ] ;
    sh:property [ sh:path :operatorIdentifier ; sh:minCount 1 ] ;
    sh:property [ sh:path tech:manufacturerIdentifier ; sh:minCount 1 ] .
