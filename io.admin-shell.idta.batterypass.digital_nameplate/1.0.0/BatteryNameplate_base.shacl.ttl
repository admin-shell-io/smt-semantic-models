@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix : <urn:samm:io.admin-shell.idta.batterypass.digital_nameplate:1.0.0#> .
@prefix tech: <urn:samm:io.admin-shell.idta.batterypass.technical_data:1.0.0#> .

# Common constraints for every BatteryNameplate use case.
# A data node is considered a BatteryNameplate when it has :uriOfTheProduct.
:BatteryNameplateBaseShape
    a sh:NodeShape ;
    sh:targetSubjectsOf :uriOfTheProduct ;

    # Mandatory in every use case
    sh:property [ sh:path :uriOfTheProduct ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :manufacturerName ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :serialNumber ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :dateOfManufacture ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :uniqueFacilityIdentifier ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :batteryStatus ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :markings ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :euDeclarationOfConformity ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :resultsOfTestReportsProvingCompliance ; sh:minCount 1 ; sh:maxCount 1 ] ;

    # Present in the canonical model, but use-case-specific requiredness
    sh:property [ sh:path :addressInformation ; sh:maxCount 1 ] ;
    sh:property [ sh:path :dateOfPuttingIntoService ; sh:maxCount 1 ] ;
    sh:property [ sh:path :operatorIdentifier ; sh:maxCount 1 ] ;
    sh:property [ sh:path tech:manufacturerIdentifier ; sh:maxCount 1 ] .
