######################################################################
# BatteryNameplate - Battery Manufacturer role
# SAMM 2.2.0 Aspect Model using AbstractEntity + samm:extends
#
# Obligations according to CX-0160-2, Appendix A (Base Model Obligation)
######################################################################

@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix : <urn:samm:io.admin-shell.idta.batterypass.digital_nameplate:1.0.0#> .

:BatteryNameplateBatteryManufacturer a samm:Aspect ;
   samm:preferredName "Battery nameplate - battery manufacturer"@en ;
   samm:preferredName "Batterie-Typenschild - Batteriehersteller"@de ;
   samm:description "Battery nameplate information provided by a battery manufacturer."@en ;
   samm:properties ( :batteryNameplateBatteryManufacturer ) ;
   samm:operations ( ) ;
   samm:events ( ) ;
   samm:see <https://admin-shell.io/idta/nameplate/3/0/Nameplate> ;
   samm:see <urn:samm:io.admin-shell.idta.digital_nameplate:3.0.0> .

:batteryNameplateBatteryManufacturer a samm:Property ;
   samm:preferredName "battery nameplate"@en ;
   samm:preferredName "Batterie-Typenschild"@de ;
   samm:description "Battery nameplate data provided by a battery manufacturer."@en ;
   samm:characteristic :BatteryNameplateBatteryManufacturerCharacteristic .

:BatteryNameplateBatteryManufacturerCharacteristic a samm-c:SingleEntity ;
   samm:dataType :BatteryNameplateBatteryManufacturerEntity .

:BatteryNameplateBatteryManufacturerEntity a samm:Entity ;
   samm:preferredName "Battery nameplate battery manufacturer data"@en ;
   samm:description "Battery nameplate data with battery manufacturer specific obligations."@en ;
   samm:extends :BatteryNameplateBaseEntity ;
   samm:properties (
      [ samm:property :serialNumber ; samm:payloadName "SerialNumber" ]
      [ samm:property :dateOfManufacture ; samm:payloadName "DateOfManufacture" ]
      [ samm:property :uniqueFacilityIdentifier ; samm:payloadName "UniqueFacilityIdentifier" ]
      [ samm:property :batteryStatus ; samm:payloadName "LifeCycleStage" ]
      [ samm:property :addressInformation ; samm:payloadName "AddressInformation" ]
      [ samm:property :markings ; samm:payloadName "Markings" ]
      [ samm:property :resultsOfTestReportsProvingCompliance ; samm:payloadName "ResultsOfTestReportsProvingCompliance" ]
   ) .
