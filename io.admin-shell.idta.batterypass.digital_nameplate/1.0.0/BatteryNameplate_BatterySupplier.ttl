######################################################################
# BatteryNameplate - Battery Supplier use case
# SAMM 2.2.0 Aspect Model using AbstractEntity + samm:extends
######################################################################

@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix tech: <urn:samm:io.admin-shell.idta.batterypass.technical_data:1.0.0#> .
@prefix : <urn:samm:io.admin-shell.idta.batterypass.digital_nameplate:1.0.0#> .

:BatteryNameplateBatterySupplier a samm:Aspect ;
   samm:preferredName "Battery nameplate - battery supplier"@en ;
   samm:preferredName "Batterie-Typenschild - Batterielieferant"@de ;
   samm:description "Battery nameplate information for the battery supplier use case."@en ;
   samm:properties ( :batteryNameplateSupplier ) ;
   samm:operations ( ) ;
   samm:events ( ) ;
   samm:see <https://admin-shell.io/idta/nameplate/3/0/Nameplate> ;
   samm:see <urn:samm:io.admin-shell.idta.digital_nameplate:3.0.0> .

:batteryNameplateSupplier a samm:Property ;
   samm:preferredName "battery nameplate"@en ;
   samm:preferredName "Batterie-Typenschild"@de ;
   samm:description "Battery nameplate data provided in the battery supplier use case."@en ;
   samm:characteristic :BatteryNameplateSupplierCharacteristic .

:BatteryNameplateSupplierCharacteristic a samm-c:SingleEntity ;
   samm:dataType :BatteryNameplateSupplierEntity .

:BatteryNameplateSupplierEntity a samm:Entity ;
   samm:preferredName "Battery nameplate supplier data"@en ;
   samm:description "Battery nameplate data with supplier-specific cardinalities."@en ;
   samm:extends :BatteryNameplateBaseEntity ;
   samm:properties (
      [ samm:property :addressInformation ; samm:optional true ; samm:payloadName "AddressInformation" ]
      [ samm:property :dateOfPuttingIntoService ; samm:optional true ; samm:payloadName "DateOfPuttingIntoService" ]
      [ samm:property :operatorIdentifier ; samm:optional true ; samm:payloadName "OperatorIdentifier" ]
      [ samm:property tech:manufacturerIdentifier ; samm:optional true ; samm:payloadName "ManufacturerIdentifier" ]
   ) .
