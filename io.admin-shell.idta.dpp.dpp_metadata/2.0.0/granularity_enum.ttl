@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.2.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ec-dppgra: <https://repository.product-passport.ec.europa.eu/core/vocabs/granularity-level#> .
@prefix : <urn:samm:io.admin-shell.idta.dpp.dpp_metadata:2.0.0#> .


  
:GranularityEnum a samm-c:Enumeration ;
   samm:preferredName "Product Identifier Granularity Level Vocabulary"@en ;
   samm:description """
   Vocabulary of product identifier granularity level concepts used by digital product passports.
   
   SOURCE: http://data.europa.eu/eli/reg_impl/2026/1778/oj
   REFERENCES: EN 18223:2026(en)  
   LICENSE: https://interoperable-europe.ec.europa.eu/collection/eupl/eupl-text-eupl-12   
   """@en ;
   samm:see <https://repository.product-passport.ec.europa.eu/core/vocabs/granularity-level> ;
   samm:dataType xsd:string ;
   samm-c:values (
     :Model
	 :Batch
	 :Item
   ) .

   
:GranularityTrait a samm-c:Trait ;
   samm-c:baseCharacteristic samm-c:Text ;
   samm-c:constraint :GranularityPattern .
   
:GranularityPattern a samm-c:RegularExpressionConstraint ;
  samm:preferredName "granularity pattern"@en ;
  samm:description "Pattern for granularity."@en ;
  samm:value "^https://repository.product-passport.ec.europa.eu/core/vocabs/granularity-level#[a-zA-Z]+$" .
  
  
:Model a samm:Value ;
   samm:see <https://repository.product-passport.ec.europa.eu/core/vocabs/granularity-level#model> ;
   samm:see <https://admin-shell.io/idta/cds/model/1> ;
   samm:see <https://admin-shell.io/aas/3/2/AssetKind/Type> ;
   samm:description """
   
   The term 'model' usually refers to a version of a product of which all units share the same technical characteristics relevant for the ecodesign requirements and the same model identifier, the term batch usually refers to a subset 
   of a specific model composed of all products produced in a specific manufacturing plant at a specific moment 
   in time and the term item usually refers to a single unit of a model. 
   
  SOURCE: ESPR p2024/1781, REGULATION (EU) 2024/1781 OF THE EUROPEAN PARLIAMENT AND OF THE COUNCIL of 13 June 2024 
  establishing a framework for the setting of ecodesign requirements for sustainable products, 
  amending Directive (EU) 2020/1828 and Regulation (EU) 2023/1542 and repealing Directive 2009/125/EC. URI: OJ:L_202401781
  
   """@en ;
   samm:value "https://repository.product-passport.ec.europa.eu/core/vocabs/granularity-level#model" ;
   samm:preferredName "Model"@en .

:Batch a samm:Value ;
   samm:see <https://repository.product-passport.ec.europa.eu/core/vocabs/granularity-level#batch> ;
   samm:see <https://admin-shell.io/idta/cds/batch/1> ;
   samm:see <https://admin-shell.io/aas/3/2/AssetKind/Batch> ;
   samm:value "https://repository.product-passport.ec.europa.eu/core/vocabs/granularity-level#batch" ;
   samm:preferredName "Batch"@en .
   
:Item a samm:Value ;
   samm:see <https://repository.product-passport.ec.europa.eu/core/vocabs/granularity-level#item> ;
   samm:see <https://admin-shell.io/idta/cds/item/1> ;
   samm:see <https://admin-shell.io/aas/3/2/AssetKind/Instance> ;
   samm:value "https://repository.product-passport.ec.europa.eu/core/vocabs/granularity-level#item" ;
   samm:preferredName "Item"@en .
 