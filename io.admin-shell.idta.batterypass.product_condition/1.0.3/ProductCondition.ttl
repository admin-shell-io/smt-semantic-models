@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.2.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <urn:samm:io.admin-shell.idta.batterypass.product_condition:1.0.3#> .
@prefix shared: <urn:samm:io.admin-shell.idta.shared:3.1.1#> .
@prefix docu: <urn:samm:io.admin-shell.idta.handover_documentation:2.0.0#> .

:ProductCondition a samm:Aspect ;
   samm:preferredName "Product Condition"@en ;
   samm:description "Covers all battery lifetime relevant properties."@en ;
   samm:properties ( 
        [ samm:property :energyThroughput; samm:optional true; samm:payloadName "EnergyThroughput" ]
        [ samm:property :capacityThroughput; samm:optional true; samm:payloadName "CapacityThroughput" ]
		[ samm:property :numberOfFullCycles; samm:payloadName "NumberOfFullCycles" ]
        [ samm:property :stateOfCertifiedEnergy; samm:optional true; samm:payloadName "StateOfCertifiedEnergy" ]
        [ samm:property :remainingEnergy; samm:optional true; samm:payloadName "RemainingEnergy" ]
        [ samm:property :remainingCapacity; samm:optional true; samm:payloadName "RemainingCapacity" ]
        [ samm:property :negativeEvents; samm:optional true; samm:payloadName "NegativeEvents" ]
        [ samm:property :informationOnAccidents; samm:payloadName "InformationOnAccidents" ]
		[ samm:property :temperatureInformation; samm:payloadName "TemperatureInformation" ]
        [ samm:property :remainingPowerCapability; samm:optional true; samm:payloadName "RemainingPowerCapability" ]
        [ samm:property :evolutionOfSelfDischarge; samm:optional true; samm:payloadName "EvolutionOfSelfDischarge" ]
        [ samm:property :currentSelfDischargingRate; samm:optional true;  samm:payloadName "CurrentSelfDischargingRate" ]
        [ samm:property :remainingRoundTripEnergyEfficiency; samm:optional true; samm:payloadName "RemainingRoundTripEnergyEfficiency" ]
        [ samm:property :stateOfCharge; samm:payloadName "StateOfCharge" ]
		) ;
   samm:operations ( ) ;
   samm:events ( ) .
   
   
 
 
:informationOnAccidents a samm:Property ;
   samm:preferredName "information on accidents"@en ;
   samm:description """
	The battery passport must contain information and data resulting from its use such as accidents.
	
	\nDIN DKE Spec 99100:2025-02 chapter reference: 6.7.8.4
	"""@en ;
   samm:see <urn:irdi:0173-1#02-ABL848#001> ;
   samm:characteristic shared:DocumentIdentifierSet .