  "properties" : {
    "EnergyThroughput" : {
      "description" : "\r\n\tThe data attribute should be reported as measured for further potential processing. \r\n    In addition, the normalisation by capacity may add a further useful value that ensures comparability among battery sizes.\r\n\t\r\n\t\nDIN DKE Spec 99100:2025-02 chapter reference: 6.7.6.7\r\n\t",
      "x-samm-aspect-model-urn" : "urn:samm:io.admin-shell.idta.batterypass.product_condition:1.0.3#energyThroughput",
      "allOf" : [ {
        "$ref" : "#/components/schemas/EnergyThroughput"
      } ]
    },
    "CapacityThroughput" : {
      "description" : "\r\n\tThe data attribute should be reported as measured for further potential processing. \r\n\tIn addition, the normalisation by capacity may add a further useful value that ensures comparability among battery sizes.\r\n\t\r\n\t\nDIN DKE Spec 99100:2025-02 chapter reference: 6.7.6.8\r\n\t",
      "x-samm-aspect-model-urn" : "urn:samm:io.admin-shell.idta.batterypass.product_condition:1.0.3#capacityThroughput",
      "allOf" : [ {
        "$ref" : "#/components/schemas/CapacityThroughput"
      } ]
    },
    "NumberOfFullCycles" : {
      "description" : "\r\n\tNumber of (full) charging and discharging cycles.\r\n\t\r\n\t\nDIN DKE Spec 99100:2025-02 chapter reference: 6.7.6.4\r\n\t",
      "x-samm-aspect-model-urn" : "urn:samm:io.admin-shell.idta.batterypass.product_condition:1.0.3#numberOfFullCycles",
      "allOf" : [ {
        "$ref" : "#/components/schemas/NumberOfFullCycles"
      } ]
    },
    "StateOfCertifiedEnergy" : {
      "description" : "\r\n\tDefinition based on UNECE GTR 22: The measured or on-board UBE performance at a specific point in its lifetime, expressed as a percentage of the certified usable battery energy.\r\n\t\r\n\t\nDIN DKE Spec 99100:2025-02 chapter reference: 6.7.2.7\r\n\t",
      "x-samm-aspect-model-urn" : "urn:samm:io.admin-shell.idta.batterypass.product_condition:1.0.3#stateOfCertifiedEnergy",
      "allOf" : [ {
        "$ref" : "#/components/schemas/StateOfCertifiedEnergy"
      } ]
    },
    "RemainingEnergy" : {
      "description" : "\r\n\tDefinition from UNECE GTR 22, applicable only to EVs.\r\n\t\r\n\tThe energy supplied by the battery from the beginning of the test procedure used for certification until the applicable break-off criterion of the test procedure used for certification is reached.\r\n\t\r\n\t\nDIN DKE Spec 99100:2025-02 chapter reference: 6.7.2.6\r\n\t",
      "x-samm-aspect-model-urn" : "urn:samm:io.admin-shell.idta.batterypass.product_condition:1.0.3#remainingEnergy",
      "allOf" : [ {
        "$ref" : "#/components/schemas/RemainingEnergy"
      } ]
    },
    "RemainingCapacity" : {
      "description" : "\r\n\tThe in-use data attribute on capacity, corresponding with the definition of rated capacity.\r\n\t\r\n\t\nDIN DKE Spec 99100:2025-02 chapter reference: 6.7.2.3\r\n\t",
      "x-samm-aspect-model-urn" : "urn:samm:io.admin-shell.idta.batterypass.product_condition:1.0.3#remainingCapacity",
      "allOf" : [ {
        "$ref" : "#/components/schemas/RemainingCapacity"
      } ]
    },
    "NegativeEvents" : {
      "description" : "\r\n\tThe battery passport must contain information and data resulting from its use such as accidents. \r\n\t\r\n\t\nDIN DKE Spec 99100:2025-02 chapter reference: 6.7.8.4\r\n\t",
      "x-samm-aspect-model-urn" : "urn:samm:io.admin-shell.idta.batterypass.product_condition:1.0.3#negativeEvents",
      "allOf" : [ {
        "$ref" : "#/components/schemas/NegativeEvents"
      } ]
    },
    "InformationOnAccidents" : {
      "description" : "\r\n\tThe battery passport must contain information and data resulting from its use such as accidents.\r\n\t\r\n\t\nDIN DKE Spec 99100:2025-02 chapter reference: 6.7.8.4\r\n\t",
      "x-samm-aspect-model-urn" : "urn:samm:io.admin-shell.idta.batterypass.product_condition:1.0.3#informationOnAccidents",
      "allOf" : [ {
        "$ref" : "#/components/schemas/DocumentIdentifierSet"
      } ]
    },
    "TemperatureInformation" : {
      "description" : "\r\n\tThe battery passport must include periodically recorded information on the operating environmental conditions, including temperature.\r\n\t\r\n\t\nDIN DKE Spec 99100:2025-02 chapter reference: 6.7.7.5 - 8\r\n\t",
      "x-samm-aspect-model-urn" : "urn:samm:io.admin-shell.idta.batterypass.product_condition:1.0.3#temperatureInformation",
      "allOf" : [ {
        "$ref" : "#/components/schemas/TemperatureInformation"
      } ]
    },
    "RemainingPowerCapability" : {
      "description" : "\r\n\tOriginal power capability (in Watts) and limits, with temperature range when relevant.\r\n\t\r\n\t- The amount of energy that a battery is capable to provide over a given period of time under reference conditions.\r\n\t\r\n\t- Power capability at 80% and 20% state of charge.\r\n\t\r\n\t\nDIN DKE Spec 99100:2025-02 chapter reference: 6.7.3.3\r\n\t",
      "x-samm-aspect-model-urn" : "urn:samm:io.admin-shell.idta.batterypass.product_condition:1.0.3#remainingPowerCapability",
      "allOf" : [ {
        "$ref" : "#/components/schemas/RemainingPowerCapability"
      } ]
    },
    "EvolutionOfSelfDischarge" : {
      "description" : "\r\n\tEvolution of self-discharge rates is the change of self-discharge over time and usage, as percentage calculated from the initial and current self-discharge rate.\r\n\t\r\n\t\nDIN DKE Spec 99100:2025-02 chapter reference: 6.7.4.8\r\n\t",
      "x-samm-aspect-model-urn" : "urn:samm:io.admin-shell.idta.batterypass.product_condition:1.0.3#evolutionOfSelfDischarge",
      "allOf" : [ {
        "$ref" : "#/components/schemas/EvolutionOfSelfDischarge"
      } ]
    },
    "CurrentSelfDischargingRate" : {
      "description" : "\r\n\tThe current self-discharge rate is the change of the self-discharge rate in an idle state of the battery in reference conditions (temperature etc.) at aging parameter x, \r\n\te.g. after a certain amount of storage time or, number of cycles.\r\n\t\r\n\t\nDIN DKE Spec 99100:2025-02 chapter reference: 6.7.4.7\r\n\t",
      "x-samm-aspect-model-urn" : "urn:samm:io.admin-shell.idta.batterypass.product_condition:1.0.3#currentSelfDischargingRate",
      "allOf" : [ {
        "$ref" : "#/components/schemas/CurrentSelfDischargingRate"
      } ]
    },
    "RemainingRoundTripEnergyEfficiency" : {
      "description" : "\r\n\tThe battery passport shall include information, where possible, about the remaining round trip energy efficiency as information on the state of health of the battery \r\n\t\r\n\t\nThe update frequency of remaining round trip energy efficiency should be aligned with the update frequency of round trip energy efficiency fade and should be provided upon change of the battery status.\r\n\t\r\n\t\nDIN DKE Spec 99100:2025-02 chapter reference: 6.7.4.4\r\n\t",
      "x-samm-aspect-model-urn" : "urn:samm:io.admin-shell.idta.batterypass.product_condition:1.0.3#remainingRoundTripEnergyEfficiency",
      "allOf" : [ {
        "$ref" : "#/components/schemas/RemainingRoundTripEnergyEfficiency"
      } ]
    },
    "StateOfCharge" : {
      "description" : "\r\n\tAvailable capacity in a battery expressed as a percentage of remaining capacity.\r\n\t\r\n\t\nDIN DKE Spec 99100:2025-02 chapter reference: 6.7.2.8 \r\n\t(changed: available energy or charge in a battery expressed as a percentage of rated capacity as declared by the manufacturer, or, when the battery’s state of health is no longer equal to its initial condition, of the maximum energy or charge that can be stored in the battery at the time of charging)\r\n\t",
      "x-samm-aspect-model-urn" : "urn:samm:io.admin-shell.idta.batterypass.product_condition:1.0.3#stateOfCharge",
      "allOf" : [ {
        "$ref" : "#/components/schemas/StateOfCharge"
      } ]
    }
  },
  "required" : [ "NumberOfFullCycles", "InformationOnAccidents", "TemperatureInformation", "StateOfCharge" ]
