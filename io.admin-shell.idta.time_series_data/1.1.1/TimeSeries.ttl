@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.2.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix shared: <urn:samm:io.admin-shell.idta.shared:4.0.0#> .
@prefix : <urn:samm:io.admin-shell.idta.time_series_data:1.1.1#> .

:TimeSeries a samm:Aspect ;
   samm:description "Contains time series data and references to time series data to discover and semantically describe them along the asset lifecycle."@en ;
   samm:description "Enthält Zeitreihendaten und Referenzen auf Zeitreihendaten, um diese entlang des Asset Lebenszyklus aufzufinden und semantisch zu beschreiben."@de ;
   samm:see <https://admin-shell.io/idta/SubmodelTemplate/TimeSeries/1/1> ;
   samm:properties (
      [ samm:property :metadata ; samm:payloadName "Metadata"  ]
      [ samm:property :segments ; samm:payloadName "Segments"  ]
   ) ;
   samm:operations ( ) .

:MetadataCharacteristic a samm-c:SingleEntity ;
   samm:dataType :Metadata .

:Metadata a samm:Entity ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Metadata/1/1> ;
   samm:properties (
      [ samm:property :metadataName ; samm:payloadName "Name"  ]
      [ samm:property :metadataDescription ; samm:payloadName "Description" ; samm:optional true ]
      [ samm:property :metadataRecords ; samm:payloadName "Records" ; samm:optional true ]
   ) .

:records a samm:Property ;
   samm:characteristic :Records .

:metadataRecords a samm:Property ;
   samm:characteristic :Records .

:Records a samm-c:List ;
   samm:dataType :Record .

:Record a samm:Entity ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Record/1/1> ;
   samm:properties (
      [ samm:property :time ; samm:payloadName "Time"  ]
      [ samm:property :sampleAccelerationX ; samm:payloadName "SampleAccelerationX" ; samm:optional true ]
      [ samm:property :sampleAccelerationY ; samm:payloadName "SampleAccelerationY" ; samm:optional true ]
      [ samm:property :sampleAccelerationZ ; samm:payloadName "SampleAccelerationZ" ; samm:optional true ]
   ) .

:SegmentsCharacteristic a samm-c:SingleEntity ;
   samm:dataType :Segments .

:Segments a samm:Entity ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Segments/1/1> ;
   samm:properties (
      [ samm:property :externalSegments ; samm:payloadName "ExternalSegments" ; samm:optional true ]
      [ samm:property :linkedSegments ; samm:payloadName "LinkedSegments" ; samm:optional true ]
      [ samm:property :internalSegments ; samm:payloadName "InternalSegments" ; samm:optional true ]
   ) .

:externalSegments a samm:Property ;
   samm:characteristic :ExternalSegments .

:ExternalSegments a samm-c:List ;
   samm:dataType :ExternalSegment .

:linkedSegments a samm:Property ;
   samm:characteristic :LinkedSegments .

:LinkedSegments a samm-c:List ;
   samm:dataType :LinkedSegment .

:internalSegments a samm:Property ;
   samm:characteristic :InternalSegments .

:InternalSegments a samm-c:List ;
   samm:dataType :InternalSegment .

:Segment a samm:AbstractEntity ;
   samm:properties (
      [ samm:property :name ; samm:payloadName "Name" ; samm:optional true ]
      [ samm:property :description ; samm:payloadName "Description" ; samm:optional true ]
      [ samm:property :recordCount ; samm:payloadName "RecordCount" ; samm:optional true ]
      [ samm:property :startTime ; samm:payloadName "StartTime" ; samm:optional true ]
      [ samm:property :endTime ; samm:payloadName "EndTime" ; samm:optional true ]
      [ samm:property :duration ; samm:payloadName "Duration" ; samm:optional true ]
      [ samm:property :samplingInterval ; samm:payloadName "SamplingInterval" ; samm:optional true ]
      [ samm:property :samplingRate ; samm:payloadName "SamplingRate" ; samm:optional true ]
      [ samm:property :state ; samm:payloadName "State" ; samm:optional true ]
      [ samm:property :lastUpdate ; samm:payloadName "LastUpdate" ; samm:optional true ]
   ) .

:ExternalSegmentCharacteristic a samm-c:SingleEntity ;
   samm:dataType :ExternalSegment .

:ExternalSegment a samm:Entity ;
   samm:properties (
      [ samm:property :externalSegmentName ; samm:payloadName "Name" ; samm:optional true ]
      [ samm:property :externalSegmentDescription ; samm:payloadName "Description" ; samm:optional true ]
      [ samm:property :externalSegmentRecordCount ; samm:payloadName "RecordCount" ; samm:optional true ]
      [ samm:property :externalSegmentStartTime ; samm:payloadName "StartTime" ; samm:optional true ]
      [ samm:property :externalSegmentEndTime ; samm:payloadName "EndTime" ; samm:optional true ]
      [ samm:property :externalSegmentDuration ; samm:payloadName "Duration" ; samm:optional true ]
      [ samm:property :externalSegmentSamplingInterval ; samm:payloadName "SamplingInterval" ; samm:optional true ]
      [ samm:property :externalSegmentSamplingRate ; samm:payloadName "SamplingRate" ; samm:optional true ]
      [ samm:property :externalSegmentState ; samm:payloadName "State" ; samm:optional true ]
      [ samm:property :externalSegmentLastUpdate ; samm:payloadName "LastUpdate" ; samm:optional true ]
      [ samm:property :externalSegmentFile ; samm:payloadName "File" ; samm:optional true ]
      [ samm:property :externalSegmentBlob ; samm:payloadName "Blob" ; samm:optional true ]
   ) .

:LinkedSegmentCharacteristic a samm-c:SingleEntity ;
   samm:dataType :LinkedSegment .

:LinkedSegment a samm:Entity ;
   samm:properties (
      [ samm:property :linkedSegmentName ; samm:payloadName "Name" ; samm:optional true ]
      [ samm:property :linkedSegmentDescription ; samm:payloadName "Description" ; samm:optional true ]
      [ samm:property :linkedSegmentRecordCount ; samm:payloadName "RecordCount" ; samm:optional true ]
      [ samm:property :linkedSegmentStartTime ; samm:payloadName "StartTime" ; samm:optional true ]
      [ samm:property :linkedSegmentEndTime ; samm:payloadName "EndTime" ; samm:optional true ]
      [ samm:property :linkedSegmentDuration ; samm:payloadName "Duration" ; samm:optional true ]
      [ samm:property :linkedSegmentSamplingInterval ; samm:payloadName "SamplingInterval" ; samm:optional true ]
      [ samm:property :linkedSegmentSamplingRate ; samm:payloadName "SamplingRate" ; samm:optional true ]
      [ samm:property :linkedSegmentState ; samm:payloadName "State" ; samm:optional true ]
      [ samm:property :linkedSegmentLastUpdate ; samm:payloadName "LastUpdate" ; samm:optional true ]
      [ samm:property :linkedSegmentEndpoint ; samm:payloadName "Endpoint"  ]
      [ samm:property :linkedSegmentQuery ; samm:payloadName "Query"  ]
   ) .

:InternalSegmentCharacteristic a samm-c:SingleEntity ;
   samm:dataType :InternalSegment .

:InternalSegment a samm:Entity ;
   samm:properties (
      [ samm:property :internalSegmentName ; samm:payloadName "Name" ; samm:optional true ]
      [ samm:property :internalSegmentDescription ; samm:payloadName "Description" ; samm:optional true ]
      [ samm:property :internalSegmentRecordCount ; samm:payloadName "RecordCount" ; samm:optional true ]
      [ samm:property :internalSegmentStartTime ; samm:payloadName "StartTime" ; samm:optional true ]
      [ samm:property :internalSegmentEndTime ; samm:payloadName "EndTime" ; samm:optional true ]
      [ samm:property :internalSegmentDuration ; samm:payloadName "Duration" ; samm:optional true ]
      [ samm:property :internalSegmentSamplingInterval ; samm:payloadName "SamplingInterval" ; samm:optional true ]
      [ samm:property :internalSegmentSamplingRate ; samm:payloadName "SamplingRate" ; samm:optional true ]
      [ samm:property :internalSegmentState ; samm:payloadName "State" ; samm:optional true ]
      [ samm:property :internalSegmentLastUpdate ; samm:payloadName "LastUpdate" ; samm:optional true ]
      [ samm:property :internalSegmentRecords ; samm:payloadName "Records" ; samm:optional true ]
   ) .

# --- Properties Definitions (Metadata) ---

:metadataName a samm:Property ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Metadata/Name/1/1> ;
   samm:characteristic shared:MultiLanguageTexts .

:metadataDescription a samm:Property ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Metadata/Description/1/1> ;
   samm:characteristic shared:MultiLanguageTexts .

:metadata a samm:Property ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Metadata/1/1> ;
   samm:characteristic :MetadataCharacteristic .

# --- Properties Definitions (Abstract / Base Segment) ---

:name a samm:Property ;
   samm:characteristic shared:MultiLanguageTexts .

:description a samm:Property ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Metadata/Description/1/1> ;
   samm:characteristic shared:MultiLanguageTexts .

:samplingInterval a samm:Property ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Segment/SamplingInterval/1/1> ;
   samm:characteristic [
      a samm:Characteristic ;
      samm:dataType xsd:long ;
   ] .

:segments a samm:Property ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Segments/1/1> ;
   samm:characteristic :SegmentsCharacteristic .

:recordCount a samm:Property ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Segment/RecordCount/1/1> ;
   samm:characteristic [
      a samm:Characteristic ;
      samm:dataType xsd:long ;
   ] .

:startTime a samm:Property ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Segment/StartTime/1/1> ;
   samm:characteristic [
      a samm:Characteristic ;
      samm:dataType xsd:dateTime ;
   ] .

:endTime a samm:Property ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Segment/EndTime/1/1> ;
   samm:characteristic [
      a samm:Characteristic ;
      samm:dataType xsd:dateTime ;
   ] ;
   samm:exampleValue "2020-09-19T14:40:38.318"^^xsd:dateTime .

:duration a samm:Property ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Segment/Duration/1/1> ;
   samm:characteristic [
      a samm:Characteristic ;
      samm:dataType xsd:string ;
   ] .

:samplingRate a samm:Property ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Segment/SamplingRate/1/1> ;
   samm:characteristic [
      a samm:Characteristic ;
      samm:dataType xsd:long ;
   ] .

:state a samm:Property ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Segment/State/1/1> ;
   samm:characteristic [
      a samm:Characteristic ;
      samm:dataType xsd:string ;
   ] .

:lastUpdate a samm:Property ;
   samm:see <https://admin-shell.io/idta/TimeSeries/Segment/LastUpdate/1/1> ;
   samm:characteristic [
      a samm:Characteristic ;
      samm:dataType xsd:dateTime ;
   ] ;
   samm:exampleValue "2020-09-19T14:40:38.318"^^xsd:dateTime .

