   samm:preferredName "TÜV sign"@en ;
   samm:see <urn:irdi:0173-1#07-AAA375#003> .
   
:VDEMarkOfConformity a samm:Value ;
   samm:value "AAA554" ;
   samm:preferredName "VDE mark of conformity"@en ;
   samm:see <urn:irdi:0173-1#07-AAA554#003> .