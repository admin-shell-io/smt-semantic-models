@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.2.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <urn:samm:io.admin-shell.idta.shared:4.0.0#> .

:Markings a samm-c:Set ;
   samm:preferredName "markings"@en ;
   samm:preferredName "Kennzeichnungen"@de ;
   samm:description "Note: CE marking is declared as mandatory according to EU Blue Guide."@en ;
   samm:see <urn:irdi:0112/2///61360_7#AAS006#001> ;
   samm:see <https://admin-shell.io/idta/cds/markings/1> ;
   samm:see <urn:irdi:0173-1#02-ABI563#004/0173-1#01-AHF849#004> ;
   samm:dataType :Marking .

:Marking a samm:Entity ;
   samm:preferredName "single marking information. Note: CE marking is declared as mandatory according to the Blue Guide of the EU-Commission"@en ;
   samm:preferredName "Kennzeichnung"@de ;
   samm:see <urn:irdi:0112/2///61360_7#AAS009#001> ;
   samm:see <https://admin-shell.io/idta/cds/marking/1> ;
   samm:see <urn:irdi:0173-1#02-ABI564#003/0173-1#01-AHF850#003> ;
   samm:properties ( 
   [ samm:property :typeOfConformityRegulation; samm:payloadName "TypeOfConformityRegulation" ] 
   [ samm:property :identifierOfCertificate; samm:optional true; samm:payloadName "IdentifierOfCertificate" ]
   [ samm:property :certificateSupplement; samm:optional true; samm:payloadName "CertificateSupplement" ]
   [ samm:property :issueDate; samm:optional true; samm:payloadName "DateOfIssue" ] 
   [ samm:property :expiryDate; samm:optional true; samm:payloadName "EndOfValidity" ] 
   [ samm:property :markingFile; samm:payloadName "MarkingFile" ]
   [ samm:property :markingAdditionalText; samm:optional true; samm:payloadName "AdditionalMarkingText" ]
   ) .


:expiryDate a samm:Property ;
   samm:preferredName "Ablaufdatum"@de ;
   samm:preferredName "expiry date"@en ;
   samm:description """
	Date when a document becomes invalid.
	
	NOTE: The format for date is the lexical representation allowed by ISO 8601, i. e. "YYYY-MM-DD" with optional time zone.
	
	synonym: ExpiryDate
	"""@en ;
   samm:see <https://admin-shell.io/idta/cds/expiryDate/1> ;
   samm:see <urn:irdi:0112/2///61360_7#CBA286#001> ;
   samm:see <urn:irdi:0173-1#02-ABL775#001> ;
   samm:see <urn:irdi:0112/2///61987#ABH830#002> ;
   samm:characteristic :Date ;
   samm:exampleValue "2022-01-01"^^xsd:date .

:Date a samm:Characteristic ;
   samm:description "Date in format CCYY-MM-DD."@en ;
   samm:dataType xsd:date .


:markingFile a samm:Property ;
   samm:preferredName "marking file"@en ;
   samm:preferredName "Kennzeichnungsbild"@de ;
   samm:description "Graphical symbol defined by and indicating conformance to a particular directive, standard or specification."@en ;
   samm:see <https://admin-shell.io/idta/cds/markingFile/1> ;
   samm:see <urn:iri:https://admin-shell.io/zvei/nameplate/2/0/Nameplate/Markings/Marking/MarkingFile> ;
   samm:characteristic :FileWithContentType .

:issueDate a samm:Property ;
   samm:preferredName "Ausstelldatum"@de ;
   samm:preferredName "issue date"@en ;
   samm:description """
	Date when a document was issued. 
	
	NOTE 1: The format for date is the lexical representation allowed by ISO 8601, i. e. "YYYY-MM-DD" with optional time zone.
	
	NOTE 2: The date of issue is normally the date, when the document becomes valid.

	synonym: IssueDate
	"""@en ;
   samm:see <https://admin-shell.io/idta/cds/expiryDate/1> ;
   samm:see <urn:iri:https://admin-shell.io/zvei/nameplate/2/0/Nameplate/Markings/Marking/IssueDate> ;
   samm:characteristic :Date ;
   samm:exampleValue "2022-01-01"^^xsd:date .

:markingAdditionalText a samm:Property ;
   samm:preferredName "additional text"@en ;
   samm:preferredName "zusätzlicher Text"@de ;
   samm:description """
   Additional plain text on a name plate indicating conformance to a particular directive, standard or specification.

	synonym: MarkingAdditionalText
   """@en ;
   samm:see <https://admin-shell.io/idta/cds/markingAdditionalText/1> ;
   samm:see <urn:irdi:0173-1%2302-ABI192%23003> ;
   samm:see <urn:irdi:0112/2///61987%23ABB146%23007> ;
   samm:see <urn:iri:https://admin-shell.io/zvei/nameplate/2/0/Nameplate/Markings/Marking/MarkingAdditionalText> ;
   samm:characteristic :MultiLanguageTexts  .

:typeOfConformityRegulation a samm:Property ;
   samm:preferredName "type of conformity regulation or certification"@en ;
   samm:description """
    Classification of a certificate or approval document according to the regulations against which the conformity of an entity is tested (IEC 61360-7).
	
	synonym: MarkingName
   """@en ;
   samm:see <urn:irdi:0112/2///61360_7#CBA276#001> ;
   samm:see <https://admin-shell.io/idta/cds/typeOfConformityRegulationCertification/1> ;
   samm:see <urn:irdi:0173-1#02-ABI190#004> ;
   samm:see <urn:irdi:0112/2///61987#ABA231#009> ;
   samm:characteristic samm-c:Text ;
   samm:exampleValue "IECEx" .

:identifierOfCertificate a samm:Property ;
   samm:preferredName "identifier of certificate, approval, declaration or license"@en ;
   samm:description """
    Alphanumeric character sequence identifying a certificate, approval, declaration or license (EC 61360-7).

    NOTE: to be entered without spaces 

    synonym: DesignationOfCertificateOrApproval
   """@en ;
   samm:see <urn:irdi:0112/2///61360_7#CBA279#001> ;
   samm:see <https://admin-shell.io/idta/cds/identifierOfCertificateApprovalDeclarationOrLicense/1> ;
   samm:see <urn:irdi:0173-1#02-ABI975#002> ;
   samm:see <urn:irdi:0112/2///61987#ABH783#003> ;
   samm:characteristic samm-c:Text ;
   samm:exampleValue "KEMA99IECEX1105/128" .

:certificateSupplement a samm:Property ;
   samm:preferredName "supplement to certificate, approval, declaration or license"@en ;
   samm:description """
    Running number or designation of a supplement/amendment issued to an existing certificate, approval, declaration or license.
   """@en ;
   samm:see <https://admin-shell.io/idta/cds/CertificateSupplement/1> ;
   samm:characteristic samm-c:Text ;
   samm:exampleValue "S1" .


:ProductMarkingEnum a samm-c:Enumeration ;
   samm:preferredName "product marking types"@en ;
   samm:dataType xsd:string ;
   samm:see <urn:irdi:0173-1%2309-AAD674%23001> ;
   samm-c:values (
      :CECC
	  :CCC
	  :CE
	  :DGRL
	  :EExIa 
	  :EExedIIC
	  :EExmII 
	  :EAC
	  :ExplosionProof
	  :GsMarkOfConformity
	  :TUEV
	  :VDEMarkOfConformity
   ) .

:CECC a samm:Value ;
   samm:value "AAA555" ;
   samm:preferredName "CECC mark of conformity"@en ;
   samm:see <urn:irdi:0173-1#07-AAA555#003> .

:CCC a samm:Value ;
   samm:value "AAB047" ;
   samm:preferredName "China Compulsiv Certification (CCC)"@en ;
   samm:see <urn:irdi:0173-1#07-AAB047#005> .
   
