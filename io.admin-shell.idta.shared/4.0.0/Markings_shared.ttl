   samm:preferredName "Explosion-proof"@en ;
   samm:see <urn:irdi:0173-1#07-WAA094#005> .
   
:GsMarkOfConformity a samm:Value ;
   samm:value "AAA374" ;
   samm:preferredName "GS mark of conformity"@en ;
   samm:see <urn:irdi:0173-1#07-AAA374#005> .
   
:TUEV a samm:Value ;
