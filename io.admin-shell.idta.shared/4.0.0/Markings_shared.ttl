   samm:value "WAA099" ;
   samm:preferredName "EEx ia"@en ;
   samm:see <urn:irdi:0173-1#07-WAA099#005> .
   
:CE a samm:Value ;
   samm:value "DAA603" ;
   samm:preferredName "Communauté Européenne (CE)"@en ;
   samm:see <urn:irdi:00173-1#07-DAA603#006> .
   
:DGRL a samm:Value ;
   samm:value "4" ;
   samm:preferredName "DGRL"@en ;
   samm:see <urn:irdi:0173-1#07-AAU119#003> .
   
:EExedIIC a samm:Value ;
   samm:value "WAA102" ;
   samm:preferredName "EExedIIC"@en ;
   samm:see <urn:irdi:0173-1#07-WAA102#005> .
   
:EExmII a samm:Value ;
   samm:value "WAA101" ;
   samm:preferredName "EExmII"@en ;
   samm:see <urn:irdi:0173-1#07-WAA101#005> .
   
:EAC a samm:Value ;
   samm:value "EAC" ;
   samm:preferredName "Eurasian Conformity (EAC)"@en ;
   samm:see <urn:irdi:0173-1#07-ABC243#003> .
   
:ExplosionProof a samm:Value ;
